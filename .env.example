# ==============================================================================
# SattaDarshan - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT: Never commit .env.local or real credentials to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Connection string for your MongoDB Atlas cluster or local MongoDB instance.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/sattadarshan?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. APPLICATION URL (Optional)
# ------------------------------------------------------------------------------
# Canonical base URL for metadata, sitemaps, and robots.txt.
# In production, set to your canonical domain (e.g. https://satta-darshan-7jgo.vercel.app).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. ON-DEMAND CACHE REVALIDATION (Optional)
# ------------------------------------------------------------------------------
# Secret token required in the `x-revalidate-secret` header for POST /api/revalidate.
REVALIDATE_SECRET=your_secure_random_revalidation_secret_here

# ------------------------------------------------------------------------------
# 4. GOOGLE SHEETS / APPS SCRIPT SUBMISSIONS (Optional)
# ------------------------------------------------------------------------------
# Web App deployment URL for server-side contact and correction intake.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec

# Shared secret token passed to Google Apps Script to verify origin.
APPS_SCRIPT_SECRET=your_apps_script_secret_token_here
